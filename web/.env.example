# Copier vers .env.local et renseigner les valeurs. Ne jamais committer de vraies valeurs.
DATABASE_URL=
ENGINE_URL=
ENGINE_SECRET=
AUTH_SECRET=
# Adresse publique du site (sans barre finale), utilisée pour les liens d'invitation.
# Si elle est vide, l'adresse est déduite de la requête (Host, X-Forwarded-Proto).
APP_URL=
