// Modèle de données MicroTrace Studio (spec §4 et §10).
// Les valeurs des enums reprennent celles du moteur (engine/openapi.json) ;
// un test de cohérence les compare. Les nombres de mesure sont des Float.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DataNature {
  published
  laboratory
  simulated
}

enum BlankCorrected {
  yes
  no
  unknown
}

enum Technique {
  py_gc_ms
  ted_gc_ms
  micro_ftir
  micro_raman
  other
}

enum Matrix {
  whole_blood
  plasma
  serum
  other
}

enum RecordType {
  sample
  procedural_blank
  field_blank
  spiked
}

enum DetectionStatus {
  quantified
  between_lod_loq
  not_quantified
  below_lod
  not_analysed
}

enum IdentificationStatus {
  confirmed
  candidate
}

enum ImportStatus {
  active
  retired
}

enum LabRole {
  lab_admin
  researcher
  viewer
}

enum PredictionKind {
  spectral
  image
  quality
}

enum PredictionStatus {
  proposed
  accepted
  corrected
  rejected
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  passwordHash    String
  active          Boolean  @default(true)
  // Équipe MicroTrace (spec §11) : crée les laboratoires, ne voit pas leurs données.
  isPlatformAdmin Boolean  @default(false)
  createdAt       DateTime @default(now())

  projects        Project[]
  memberships     Membership[]
  invitationsSent Invitation[]
}

// Laboratoire client du SaaS (spec §11) : frontière d'isolation des données.
model Laboratory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  createdAt   DateTime  @default(now())
  suspendedAt DateTime?

  memberships Membership[]
  invitations Invitation[]
  projects    Project[]
  studies     Study[]
  auditEvents AuditEvent[]
}

model Membership {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  laboratoryId String
  laboratory   Laboratory @relation(fields: [laboratoryId], references: [id])
  role         LabRole
  createdAt    DateTime   @default(now())

  @@unique([userId, laboratoryId])
  @@index([laboratoryId])
}

// Le jeton n'est jamais stocké en clair : seule son empreinte SHA-256 l'est.
model Invitation {
  id           String     @id @default(cuid())
  laboratoryId String
  laboratory   Laboratory @relation(fields: [laboratoryId], references: [id])
  email        String
  role         LabRole
  tokenHash    String     @unique
  invitedById  String
  invitedBy    User       @relation(fields: [invitedById], references: [id])
  expiresAt    DateTime
  usedAt       DateTime?
  revokedAt    DateTime?
  createdAt    DateTime   @default(now())

  @@index([laboratoryId])
}

model Project {
  id           String     @id @default(cuid())
  title        String
  description  String     @default("")
  ownerId      String
  owner        User       @relation(fields: [ownerId], references: [id])
  laboratoryId String
  laboratory   Laboratory @relation(fields: [laboratoryId], references: [id])
  createdAt    DateTime   @default(now())

  studies Study[]

  @@unique([id, laboratoryId])
  @@index([laboratoryId])
}

model Study {
  id                    String         @id @default(cuid())
  projectId             String
  project               Project        @relation(fields: [projectId, laboratoryId], references: [id, laboratoryId])
  laboratoryId          String
  laboratory            Laboratory     @relation(fields: [laboratoryId], references: [id])
  title                 String
  nature                DataNature
  referenceDoi          String?
  referenceLicense      String?
  blankCorrected        BlankCorrected @default(unknown)
  pseudonymDeclaredAt   DateTime?
  pseudonymDeclaredById String?
  archivedAt            DateTime?
  createdAt             DateTime       @default(now())

  methods        Method[]
  limits         DetectionLimit[]
  qcSummaries    QualityControlSummary[]
  dataFiles      DataFile[]
  importRuns     ImportRun[]
  predictions    ModelPrediction[]
  measurements   Measurement[]
  qcMeasurements QcMeasurement[]

  @@index([projectId])
  @@index([laboratoryId])
}

model Method {
  id        String    @id @default(cuid())
  studyId   String
  study     Study     @relation(fields: [studyId], references: [id])
  name      String
  nameKey   String
  technique Technique

  limits DetectionLimit[]

  @@unique([studyId, nameKey])
  @@unique([id, studyId])
}

model DetectionLimit {
  id       String @id @default(cuid())
  studyId  String
  study    Study  @relation(fields: [studyId], references: [id])
  methodId String
  method   Method @relation(fields: [methodId, studyId], references: [id, studyId], onDelete: Restrict)
  polymer  String
  lod      Float?
  loq      Float?
  unitCode String
  source   String

  @@unique([studyId, methodId, polymer])
}

model QualityControlSummary {
  id       String @id @default(cuid())
  studyId  String
  study    Study  @relation(fields: [studyId], references: [id])
  polymer  String
  kind     String
  n        Int
  mean     Float?
  sd       Float?
  unitCode String
  source   String
}

model DataFile {
  id           String   @id @default(cuid())
  studyId      String
  study        Study    @relation(fields: [studyId], references: [id])
  originalName String
  sha256       String
  sizeBytes    Int
  mimeType     String
  storagePath  String
  uploadedById String
  createdAt    DateTime @default(now())

  importRuns ImportRun[]

  @@unique([studyId, sha256])
  @@unique([id, studyId])
}

// ATTENTION : l'index unique partiel `ImportRun_one_active_per_file`
// (studyId, dataFileId) WHERE status = 'active' est géré en SQL brut dans la
// migration 20261025000200 et n'apparaît pas ici. Il doit être conservé :
// relire systématiquement le SQL généré par `prisma migrate dev`.
model ImportRun {
  id                   String       @id @default(cuid())
  studyId              String
  study                Study        @relation(fields: [studyId], references: [id])
  dataFileId           String
  dataFile             DataFile     @relation(fields: [dataFileId, studyId], references: [id, studyId], onDelete: Restrict)
  sheet                String?
  mapping              Json
  frozenContext        Json
  rulesVersion         String
  engineVersion        String
  issues               Json
  errorCount           Int          @default(0)
  warningCount         Int          @default(0)
  infoCount            Int          @default(0)
  nRows                Int?
  warningsAccepted     Boolean      @default(false)
  warningsAcceptedAt   DateTime?
  warningsAcceptedById String?
  status               ImportStatus @default(active)
  retiredReason        String?
  retiredAt            DateTime?
  createdById          String
  createdAt            DateTime     @default(now())

  measurements   Measurement[]
  qcMeasurements QcMeasurement[]

  @@index([studyId, status])
  @@index([dataFileId])
  @@unique([id, studyId])
}

// Un enregistrement de B1 (MeasurementRecordModel, 28 champs) + importRunId/studyId.
// Colonnes en camelCase ; la correspondance snake_case <-> camelCase vivra dans
// un seul assistant (C3).
model Measurement {
  id                   String               @id @default(cuid())
  importRunId          String
  importRun            ImportRun            @relation(fields: [importRunId, studyId], references: [id, studyId], onDelete: Restrict)
  studyId              String
  study                Study                @relation(fields: [studyId], references: [id])
  sampleId             String
  aliquot              String
  recordType           RecordType
  matrix               Matrix
  matrixDetail         String
  polymer              String
  polymerRaw           String
  method               String
  technique            Technique
  reportedValue        String
  value                Float?
  unitCode             String
  canonicalValue       Float?
  canonicalUnitCode    String
  status               DetectionStatus
  lod                  Float?
  loq                  Float?
  canonicalLod         Float?
  canonicalLoq         Float?
  identificationStatus IdentificationStatus
  sizeMinUm            Float?
  sizeMaxUm            Float?
  analysisDate         String
  batch                String
  lab                  String
  comment              String
  sourceRow            Int
  sourceColumn         String

  @@index([studyId])
  @@index([importRunId])
}

model QcMeasurement {
  id                   String               @id @default(cuid())
  importRunId          String
  importRun            ImportRun            @relation(fields: [importRunId, studyId], references: [id, studyId], onDelete: Restrict)
  studyId              String
  study                Study                @relation(fields: [studyId], references: [id])
  sampleId             String
  aliquot              String
  recordType           RecordType
  matrix               Matrix
  matrixDetail         String
  polymer              String
  polymerRaw           String
  method               String
  technique            Technique
  reportedValue        String
  value                Float?
  unitCode             String
  canonicalValue       Float?
  canonicalUnitCode    String
  status               DetectionStatus
  lod                  Float?
  loq                  Float?
  canonicalLod         Float?
  canonicalLoq         Float?
  identificationStatus IdentificationStatus
  sizeMinUm            Float?
  sizeMaxUm            Float?
  analysisDate         String
  batch                String
  lab                  String
  comment              String
  sourceRow            Int
  sourceColumn         String

  @@index([studyId])
  @@index([importRunId])
}

model ModelPrediction {
  id              String           @id @default(cuid())
  studyId         String
  study           Study            @relation(fields: [studyId], references: [id])
  kind            PredictionKind
  inputFileSha256 String?
  input           Json
  output          Json
  score           Float?
  modelName       String
  modelVersion    String
  modelSha256     String?
  status          PredictionStatus @default(proposed)
  decidedById     String?
  decidedAt       DateTime?
  decisionNote    String?
  createdAt       DateTime         @default(now())

  @@index([studyId])
}

model AuditEvent {
  id           String      @id @default(cuid())
  actorId      String?
  action       String
  entityType   String
  entityId     String
  before       Json?
  after        Json?
  // Vide pour les événements de la plateforme (connexion, création d'utilisateur).
  laboratoryId String?
  laboratory   Laboratory? @relation(fields: [laboratoryId], references: [id], onDelete: Restrict)
  createdAt    DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([laboratoryId])
}
