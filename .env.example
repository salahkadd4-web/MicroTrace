# Variables lues par docker-compose.yml. Copiez ce fichier en `.env` avec
#   node scripts/generate-secrets.mjs
# ne mettez jamais de vraies valeurs ici et ne partagez jamais `.env`.

# Mot de passe de la base PostgreSQL (généré).
POSTGRES_PASSWORD=
# Secret partagé entre l'application et le moteur, au moins 32 caractères (généré).
ENGINE_SECRET=
# Secret de signature des sessions, au moins 32 caractères (généré).
AUTH_SECRET=
# Adresse publique de l'application, sans barre finale (liens d'invitation).
# Obligatoire en production (ex. https://labo.exemple.fr). Par défaut : http://localhost:3000
APP_URL=http://localhost:3000
